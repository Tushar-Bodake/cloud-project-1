rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/files/{fileId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         firestore.exists(/databases/(default)/documents/files/$(fileId)/fileAccess/$(request.auth.uid)));
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
