rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /files/{fileId} {
      allow read: if request.auth != null &&
        (resource.data.ownerId == request.auth.uid ||
         exists(/databases/$(database)/documents/files/$(fileId)/fileAccess/$(request.auth.uid)));
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /fileAccess/{recipientId} {
        allow read: if request.auth != null &&
          (recipientId == request.auth.uid ||
           get(/databases/$(database)/documents/files/$(fileId)).data.ownerId == request.auth.uid);
        allow create: if request.auth != null &&
          (request.resource.data.ownerId == request.auth.uid ||
           recipientId == request.auth.uid);
        allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      }
    }
    match /activityLogs/{activityId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{path=**}/fileAccess/{accessId} {
      allow read: if request.auth != null &&
        resource.data.recipientId == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
